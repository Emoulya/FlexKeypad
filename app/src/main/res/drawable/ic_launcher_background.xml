            <gradient
                android:startX="15"
                android:startY="10"
                android:endX="95"
                android:endY="100"
                android:type="linear">
                <item android:offset="0.0" android:color="#1A1E2F" />
                <item android:offset="0.5" android:color="#10121B" />
